        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌ریزی کمتر.\nکشف و تجربه بیشتر."
          }
        }
      }
    },
    "I'm Pip. Let's make this trip feel like you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm Pip. Let's make this trip feel like you."
